# LLM provider key (provider chosen when the agents are built)
OPENAI_API_KEY=

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://btc:btc@localhost:5433/btc_risk

# Langfuse tracing (cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional overrides
# CHAT_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
